# Pricing
INR_PER_USDT=88
SPREAD_BPS=100                 # 1% for the LP

# Drain protection
MIN_ORDER_PAISE=1000           # ₹10 minimum
MAX_GAS_PRICE_GWEI=5
MAX_PAYS_PER_PAYER_PER_MIN=6
MAX_REQ_PER_IP_PER_MIN=60

# UPI payout verification: mock | razorpayx
PAYOUT_PROVIDER=mock
RAZORPAY_KEY_ID=
